# Backend environment variables — copy to `.env` for local dev,
# set them in your hosting provider's dashboard for production.

# Google Places + Geocoding API key (Places API legacy, not "New").
GOOGLE_PLACES_API_KEY=

# OpenCode Zen API key. Used for DeepSeek V4 Flash place blurbs + narrative.
# If empty, the app falls back to deterministic heuristic strings.
OPENCODE_API_KEY=

# Comma-separated list of origins allowed to call this API.
# Example for production: https://yourapp.vercel.app,https://yourapp.com
# Defaults to localhost dev ports if unset.
ALLOWED_ORIGINS=
